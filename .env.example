# 可选配置（全部非必填，不设置则使用默认值）

# 监听地址与端口
HOST=127.0.0.1
PORT=5000

# SQLite 数据库路径
# DB_PATH=./data.db

# 可选：前端构建产物目录
# FRONTEND_DIST=./frontend_dist

